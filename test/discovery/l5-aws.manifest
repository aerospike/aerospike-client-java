# Manifest for the l5-aws harness in aerospike-client-conformance (l5-aws/README.md).
# Each command runs with bash on the runner (Amazon Linux 2023) from the repository root.
L5_SETUP='sudo dnf install -y -q java-21-amazon-corretto-devel && { sudo dnf install -y -q maven-amazon-corretto21 || sudo dnf install -y -q maven; }'
L5_BUILD='export JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto && mvn -B -q -pl client -am install -DskipTests && mvn -B -q -pl test test -DskipTests'
L5_RUN='export JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto && test/discovery/run_l5.sh'
